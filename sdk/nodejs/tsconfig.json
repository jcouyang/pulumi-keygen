    "files": [
        "age/decrypt.ts",
        "age/encrypt.ts",
        "age/identity.ts",
        "age/index.ts",
        "awskms/dataKey.ts",
        "awskms/dataKeyPair.ts",
        "awskms/decrypt.ts",
        "awskms/encrypt.ts",
        "awskms/index.ts",
        "awskms/random.ts",
        "config/index.ts",
        "config/vars.ts",
        "index.ts",
        "pem/encode.ts",
        "pem/index.ts",
        "pkcs11/decrypt.ts",
        "pkcs11/encrypt.ts",
        "pkcs11/index.ts",
        "pkcs11/key.ts",
        "provider.ts",
        "utilities.ts"
    ]
}
